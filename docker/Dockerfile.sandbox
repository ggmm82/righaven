# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS software
USER root
ARG TARGETARCH
# Basic file/code environment only. Native application libraries are installed per recipe.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv python3-pil git fontconfig fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true PYTHONDONTWRITEBYTECODE=1
COPY versions.lock.json /opt/righaven/versions.lock.json
RUN codex_version="$(node -p 'require("/opt/righaven/versions.lock.json").cli_runtimes.codex')" \
    && npm install -g "@openai/codex@$codex_version" \
    && codex --version && npm cache clean --force
COPY scripts/install_antigravity.py scripts/antigravity.lock.json /opt/righaven/
RUN python3 /opt/righaven/install_antigravity.py "$TARGETARCH" && agy --version
COPY scripts/install_righaven.py scripts/install_system_packages.py /opt/righaven/
COPY config/toolkit /opt/righaven/toolkit-lock/
COPY scripts/check_provider_clis.py /opt/righaven/
RUN python3 /opt/righaven/check_provider_clis.py
COPY scripts/build_design_web.cjs scripts/StructurizrJob.java /opt/righaven/
COPY config/tool-capabilities.json /opt/righaven/tool-capabilities.json
RUN ln -s /opt/righaven/craft.py /usr/local/bin/craft \
    && ln -s /opt/righaven/blender_cli.py /usr/local/bin/blender-cli \
    && ln -s /opt/righaven/calibre_cli.py /usr/local/bin/calibre-cli \
    && for app in playwright aubio fluidsynth epubcheck pandoc typst freecad whisper-cpp ffmpeg musescore ifcopenshell manim opentimelineio pymeshlab d2 plantuml mermaid excalidraw bpmn structurizr opengrep trivy duckdb jupyter quarto poppler qpdf verapdf ocrmypdf tesseract gdal qgis schemathesis k6 axe-core zap gitleaks openmodelica highs kicad ngspice prusaslicer usql schemacrawler dlt sqlmesh sqlglot hledger beancount openbabel xtb seqkit samtools bcftools minimap2 mafft z3 minizinc maxima pari cdo nco exiftool mat2 fonttools fontforge zint shellcheck hadolint actionlint tflint spectral jq yq miller ajv mjml abcm2ps abcmidi hunspell vale tbls faker supercronic; do ln -s /opt/righaven/toolkit_cli.py "/usr/local/bin/$app-cli"; done
ENV TZ=Europe/Rome LANG=C.UTF-8 LC_ALL=C.UTF-8 NO_BROWSER=true
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/righaven/playwright-browsers
WORKDIR /mnt/user-data
RUN cp /opt/righaven/versions.lock.json /opt/righaven/catalog.lock.json \
    && cp /opt/righaven/tool-capabilities.json /opt/righaven/catalog-capabilities.json \
    && python3 -c "import json; from pathlib import Path; [p.write_text(json.dumps({**json.loads(p.read_text()), 'applications':[]})) for p in [Path('/opt/righaven/versions.lock.json'), Path('/opt/righaven/tool-capabilities.json')]]" \
    && printf '[]\n' > /opt/righaven/installed.json
LABEL org.righaven.runtime.kind="software"
CMD ["python3", "-c", "print('RigHaven Core ready; on-demand tools available')"]


FROM software AS core
COPY scripts/data_specs.py scripts/data_tools.py scripts/data_job.py scripts/acceptance_data.py /opt/righaven/
COPY scripts/domain_specs.py scripts/domain_tools.py scripts/acceptance_domain.py /opt/righaven/
COPY scripts/pipeline_specs.py scripts/pipeline_tools.py scripts/pipeline_job.py scripts/pipeline_model.py scripts/pipeline_scaffold.py scripts/stubgen.py scripts/acceptance_pipeline.py /opt/righaven/
COPY scripts/extended_specs.py scripts/extended_tools.py scripts/extended_runner.py scripts/extended_axe.cjs scripts/acceptance_extended.py scripts/install_extended.py /opt/righaven/
COPY scripts/runtime_policy.py scripts/security_specs.py scripts/security_tools.py /opt/righaven/
COPY scripts/craft.py scripts/smoke.py scripts/acceptance.py scripts/acceptance_toolkit.py scripts/acceptance_production.py scripts/acceptance_design.py scripts/acceptance_security.py /opt/righaven/
COPY scripts/blender_cli.py scripts/blender_job.py scripts/calibre_cli.py scripts/calibre_job.py scripts/calibre_css.cjs /opt/righaven/
COPY scripts/toolkit_cli.py scripts/toolkit_specs.py scripts/schema_types.py scripts/production_specs.py scripts/production_tools.py scripts/production_job.py scripts/production_render.py scripts/toolkit_job.py scripts/toolkit_browser.cjs scripts/toolkit_capture.py /opt/righaven/
COPY righaven/operations.py righaven/resource_usage.py righaven/source_packages.py /opt/righaven/
COPY righaven/design_models.py /opt/righaven/
COPY scripts/design_specs.py scripts/design_tools.py scripts/design_browser.cjs scripts/design_plantuml.py scripts/build_design_web.cjs scripts/StructurizrJob.java /opt/righaven/
RUN chmod 755 /opt/righaven/*_cli.py /opt/righaven/craft.py
COPY skills /mnt/skills
COPY scripts/capability_catalog.py scripts/check_tool_capabilities.py /opt/righaven/
COPY righaven/run_agent.py righaven/handoff.py righaven/deepseek.py righaven/refresh_codex.py /opt/righaven-worker/
COPY righaven/openai_compatible.py righaven/early_delivery.py /opt/righaven-worker/
COPY righaven/skill_composition.py /opt/righaven-worker/
COPY righaven/antigravity_cli.py righaven/terminal_text.py /opt/righaven-worker/
COPY righaven/progress.py righaven/cli_runner.py righaven/work_results.py righaven/operations.py righaven/resource_usage.py /opt/righaven-worker/
COPY righaven/codex_native.py righaven/worker_context.py righaven/audit_log.py righaven/command_details.py /opt/righaven-worker/
COPY righaven/source_packages.py righaven/deliveries.py righaven/acceptance.py righaven/revision.py /opt/righaven-worker/
COPY righaven/component_sources.py righaven/timing.py /opt/righaven-worker/
COPY scripts/prepare_environment.py scripts/resolve_tool_version.py scripts/apply_tool_versions.py /opt/righaven/
LABEL org.righaven.runtime.kind="core"

FROM core AS runtime
