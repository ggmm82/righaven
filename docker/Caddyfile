{$RIGHAVEN_SITE} {
    # The app manifest and its icons are public, so phones can install RigHaven
    # (browsers fetch them without the sign-in credentials). They contain no data.
    # RigHaven Agent authenticates itself (pairing code, then its own token): no site password there.
    @protected not path /manifest.webmanifest /rh-app/* /api/webhooks/righaven-agent/*
    basic_auth @protected {
        {$RIGHAVEN_USER} {$RIGHAVEN_PASSWORD_HASH}
    }
    @harness path /harness /harness/*
    handle @harness {
        reverse_proxy gateway:8001 {
            header_up -Authorization
            header_up Host {hostport}
            flush_interval -1
        }
    }
    handle /health* {
        reverse_proxy gateway:8001 {
            header_up -Authorization
        }
    }
    handle /api/langgraph/* {
        uri replace /api/langgraph /api
        reverse_proxy gateway:8001 {
            header_up -Authorization
            header_up Host {hostport}
            flush_interval -1
        }
    }
    handle /api/* {
        reverse_proxy gateway:8001 {
            header_up -Authorization
            header_up Host {hostport}
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000 {
            header_up -Authorization
            header_up Host {hostport}
        }
    }
}
