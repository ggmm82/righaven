# syntax=docker/dockerfile:1
# Frontend Dockerfile
# Supports two targets:
#   --target dev   — install deps only, run `pnpm dev` at container start
#   --target prod  — full build baked in, run `pnpm start` at container start (default if no --target is specified)

ARG PNPM_STORE_PATH=/root/.local/share/pnpm/store
ARG NPM_REGISTRY

# ── Base: shared setup ────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ARG PNPM_STORE_PATH
ARG NPM_REGISTRY
# Configure corepack registry before installing pnpm so the download itself
# succeeds in restricted networks (COREPACK_NPM_REGISTRY controls where
# corepack fetches package managers from).
RUN if [ -n "${NPM_REGISTRY}" ]; then \
      export COREPACK_NPM_REGISTRY="${NPM_REGISTRY}"; \
    fi && \
    corepack enable && corepack install -g pnpm@10.26.2
RUN pnpm config set store-dir ${PNPM_STORE_PATH}
# Optionally override npm registry for restricted networks (e.g. NPM_REGISTRY=https://registry.npmmirror.com)
RUN if [ -n "${NPM_REGISTRY}" ]; then pnpm config set registry "${NPM_REGISTRY}"; fi
WORKDIR /app
COPY core/frontend ./frontend
COPY frontend/locales ./frontend/src/app/workspace/locales
COPY frontend/i18n.tsx ./frontend/src/app/workspace/i18n.tsx
COPY frontend/harness-page.tsx ./frontend/src/app/workspace/harness/page.tsx
COPY frontend/gallery-feedback.tsx ./frontend/src/app/workspace/gallery/gallery-feedback.tsx
COPY frontend/environment-lifecycle.tsx ./frontend/src/app/workspace/environments/environment-lifecycle.tsx
COPY frontend/gallery-page.tsx ./frontend/src/app/workspace/gallery/page.tsx
COPY frontend/cloud-portal-page.tsx ./frontend/src/app/workspace/cloud/page.tsx
COPY frontend/environments-page.tsx ./frontend/src/app/workspace/environments/page.tsx
COPY frontend/tool-versions.tsx ./frontend/src/app/workspace/environments/tool-versions.tsx
COPY frontend/environment-terminal-page.tsx ./frontend/src/app/terminal/page.tsx
COPY frontend/team-onboarding.tsx ./frontend/src/components/workspace/team-onboarding.tsx
COPY frontend/model-settings-page.tsx ./frontend/src/components/workspace/settings/model-settings-page.tsx
COPY frontend/run-start-time.ts ./frontend/src/core/messages/run-start-time.ts
COPY frontend/delegate-progress.tsx frontend/delegate-progress-state.ts frontend/experience-panel.tsx frontend/conversation-audit.tsx frontend/project-guide.tsx frontend/project-design.tsx ./frontend/src/components/workspace/messages/
COPY scripts/check_chat_modes.mjs /tmp/check_chat_modes.mjs
RUN node --experimental-strip-types /tmp/check_chat_modes.mjs

COPY config/web-terminal /tmp/web-terminal/
RUN npm ci --prefix /tmp/web-terminal --ignore-scripts --no-audit --no-fund \
    && mkdir -p /app/frontend/public/rh-terminal \
    && cp /tmp/web-terminal/node_modules/@xterm/xterm/lib/xterm.js /app/frontend/public/rh-terminal/ \
    && cp /tmp/web-terminal/node_modules/@xterm/xterm/css/xterm.css /app/frontend/public/rh-terminal/ \
    && cp /tmp/web-terminal/node_modules/@xterm/addon-fit/lib/addon-fit.js /app/frontend/public/rh-terminal/ \
    && cp /tmp/web-terminal/node_modules/@xterm/xterm/LICENSE /app/frontend/public/rh-terminal/xterm-LICENSE \
    && cp /tmp/web-terminal/node_modules/@xterm/addon-fit/LICENSE /app/frontend/public/rh-terminal/addon-fit-LICENSE

# ── Dev: install only, CMD is overridden by docker-compose ───────────────────
FROM base AS dev
RUN cd /app/frontend && pnpm install --frozen-lockfile
EXPOSE 3000

# ── Builder: install + compile Next.js ───────────────────────────────────────
FROM base AS builder
COPY config/toolkit/design/excalidraw /tmp/design-excalidraw/
COPY config/toolkit/design/bpmn /tmp/design-bpmn/
COPY scripts/build_design_web.cjs /tmp/build_design_web.cjs
RUN PUPPETEER_SKIP_DOWNLOAD=true npm ci --prefix /tmp/design-excalidraw --ignore-scripts --no-audit --no-fund \
    && PUPPETEER_SKIP_DOWNLOAD=true npm ci --prefix /tmp/design-bpmn --ignore-scripts --no-audit --no-fund \
    && node /tmp/build_design_web.cjs excalidraw /tmp/design-excalidraw /app/frontend/public/rh-design/excalidraw \
    && node /tmp/build_design_web.cjs bpmn /tmp/design-bpmn /app/frontend/public/rh-design/bpmn
RUN cd /app/frontend && pnpm install --frozen-lockfile
# Skip env validation — runtime vars are injected by nginx/container
# App version stamp for the About page. Nightly CI passes
# APP_VERSION=<base>-nightly.<date>-<sha>; release/local builds leave it empty
# and the frontend falls back to package.json's version.
ARG APP_VERSION=""
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION
ENV NODE_OPTIONS=--max-old-space-size=2048
ENV NEXT_CONFIG_BUILD_OUTPUT=standalone
RUN cd /app/frontend && SKIP_ENV_VALIDATION=1 pnpm build

# ── Prod: minimal runtime with pre-built output ───────────────────────────────
FROM node:22-alpine AS prod
WORKDIR /app/frontend
ENV HOSTNAME=0.0.0.0 PORT=3000 NODE_ENV=production
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./.next/static
COPY --from=builder /app/frontend/public ./public
COPY docs/UPSTREAM-LICENSE /app/THIRD-PARTY-NOTICES
EXPOSE 3000
COPY docker/frontend-entrypoint.sh /usr/local/bin/rh-frontend
RUN chmod 755 /usr/local/bin/rh-frontend
ENTRYPOINT ["/usr/local/bin/rh-frontend"]
