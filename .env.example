# Copy to .env for local startup. For VPS/Hostinger deployments, set RIGHAVEN_PASSWORD and TRAEFIK_HOST.
# Execution mode: community (Self-Hosted Open Source) or cloud (Multi-Tenant Cloud Portal).
RIGHAVEN_EDITION=community
# Local Caddy proxy credentials and binding settings.
RIGHAVEN_USER=admin
RIGHAVEN_PASSWORD=
# Leave empty for local HTTP testing; set domain without https:// for Caddy automatic TLS.
RIGHAVEN_DOMAIN=
RIGHAVEN_PUBLIC_URL=http://localhost:2026
RIGHAVEN_BIND_IP=0.0.0.0
# Default UI & Gateway fallback locale (en | it).
RIGHAVEN_DEFAULT_LOCALE=en
# Worker Internet access: open (bridge network) or allowlist (internal network; only the model
# provider and the domains each role declares with a reason, through the egress proxy).
RIGHAVEN_WORKER_EGRESS=open
# Base domain for Traefik ingress on VPS/Hostinger (e.g. srv0000000.hstgr.cloud).
TRAEFIK_HOST=
# Allow connections to databases and devices on private networks (allow), and list the device
# nodes tasks may receive as connections, comma separated (for example /dev/ttyUSB0,/dev/ttyACM0).
RIGHAVEN_CONNECTIONS_PRIVATE_NETWORKS=
RIGHAVEN_DEVICES=
