{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RigHaven Community Gallery Pack Manifest (righaven-pack.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "author",
    "category",
    "i18n",
    "docker_dependencies",
    "cli_binaries",
    "skill_prompt_template",
    "verification_command",
    "security_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "enum": [
        "environment",
        "cli-tool",
        "skill"
      ]
    },
    "i18n": {
      "type": "object",
      "required": [
        "en",
        "it"
      ],
      "properties": {
        "en": {
          "type": "object",
          "required": [
            "title",
            "description"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2
            },
            "description": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "it": {
          "type": "object",
          "required": [
            "title",
            "description"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2
            },
            "description": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "docker_dependencies": {
      "type": "object",
      "required": [
        "base_image",
        "system_packages",
        "python_packages",
        "node_packages"
      ],
      "properties": {
        "base_image": {
          "type": "string"
        },
        "system_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "python_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nix_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cli_binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "executable",
          "safe_flags",
          "health_check"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "executable": {
            "type": "string"
          },
          "safe_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "health_check": {
            "type": "string"
          }
        }
      }
    },
    "skill_prompt_template": {
      "type": "string",
      "minLength": 10
    },
    "verification_command": {
      "type": "string",
      "minLength": 3
    },
    "security_policy": {
      "type": "object",
      "required": [
        "rootless",
        "network_access",
        "writable_paths",
        "read_only_mounts"
      ],
      "properties": {
        "rootless": {
          "type": "boolean"
        },
        "network_access": {
          "type": "boolean"
        },
        "writable_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only_mounts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drop_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_new_privileges": {
          "type": "boolean"
        }
      }
    }
  }
}
