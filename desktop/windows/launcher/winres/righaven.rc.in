// Icon and version of RigHaven.exe; @...@ placeholders are filled by desktop-windows.yml.
1 ICON "righaven.ico"
1 VERSIONINFO
FILEVERSION @MAJOR@,@MINOR@,@PATCH@,0
PRODUCTVERSION @MAJOR@,@MINOR@,@PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "RigHaven"
      VALUE "FileDescription", "RigHaven"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "RigHaven"
      VALUE "OriginalFilename", "RigHaven.exe"
      VALUE "ProductName", "RigHaven"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
