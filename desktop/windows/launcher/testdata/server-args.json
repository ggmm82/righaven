{
 "note": "Written from righaven.docker_runtime.base_arguments by tests/test_compute_nodes.py; checked by the node in launcher_test.go.",
 "image": "righaven-env:abc",
 "mounts": [
  {
   "key": "m0",
   "mode": "ro",
   "kind": "dir",
   "target": "/mnt/user-data"
  },
  {
   "key": "m1",
   "mode": "rw",
   "kind": "dir",
   "target": "/mnt/user-data/outputs/x"
  },
  {
   "key": "m2",
   "mode": "ro",
   "kind": "file",
   "target": "/job.json"
  }
 ],
 "args": [
  "run",
  "--name",
  "rh-job-0123456789ab",
  "--label",
  "org.righaven.harness.owner=harness",
  "--init",
  "--cap-drop=ALL",
  "--security-opt=no-new-privileges",
  "--pids-limit=256",
  "--memory=2048m",
  "--memory-swap=2048m",
  "--cpus=2.0",
  "--network=bridge",
  "--tmpfs",
  "/tmp:rw,size=512m",
  "--env",
  "RIGHAVEN_CPU_THREADS=2",
  "--env",
  "RIGHAVEN_MEMORY_MIB=2048",
  "--env",
  "NO_BROWSER=true",
  "--env",
  "TZ=Europe/Rome",
  "--env",
  "TOKIO_WORKER_THREADS=2",
  "--env",
  "RAYON_NUM_THREADS=2",
  "--env",
  "OMP_NUM_THREADS=2",
  "--env",
  "OPENBLAS_NUM_THREADS=2",
  "--tmpfs",
  "/opt/righaven/apps/ffmpeg:ro,size=1m",
  "--env",
  "PATH=/opt/righaven-provider/bin:/usr/bin:/bin",
  "--label",
  "org.righaven.harness.installation=0f3c2a9e-5d41-4b7a-9c1e-2b8d7f6a5e40",
  "--label",
  "org.righaven.harness.workspace=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "--mount",
  "type=bind,src={m0},dst=/mnt/user-data,readonly",
  "--mount",
  "type=bind,src={m1},dst=/mnt/user-data/outputs/x",
  "--mount",
  "type=bind,src={m2},dst=/job.json,readonly",
  "righaven-env:abc",
  "python3",
  "/opt/righaven-worker/run_agent.py",
  "/job.json"
 ]
}
